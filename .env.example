# Copy to .env (make does this on first run). Values here are local dev defaults.

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
# Host processes use localhost; containers get kafka:29092 from docker-compose.yml
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_CELL_TESTS=cell_tests
TOPIC_ASSEMBLY_EVENTS=assembly_events
TOPIC_FAULT_LOG=fault_log

# Lakehouse root. Containers mount ${LAKEHOUSE_MOUNT} at /lakehouse.
# The default named volume is fast on Docker Desktop; ./lakehouse makes the files
# visible on the host but is about 5x slower for Delta's small-file writes on Windows.
LAKEHOUSE_ROOT=./lakehouse
LAKEHOUSE_MOUNT=lakehouse

# Generator
GENERATOR_RATE=50
GENERATOR_SEED=42
GENERATOR_LINES=3
GENERATOR_STATIONS_PER_LINE=4
CELLS_PER_LOT=5000
CELLS_PER_MODULE=46
MODULES_PER_PACK=4
# Fault injection
DRIFT_STATION=L2-S3
DRIFT_START_AFTER_S=600
DRIFT_RAMP_S=600
DRIFT_IR_MAX_DELTA_MOHM=0.25
BAD_LOT_INDEX=5
BAD_LOT_CAPACITY_DELTA_AH=-0.12
SENSOR_DROPOUT_RATE=0.005
DUPLICATE_RATE=0.01
LATE_RATE=0.01
LATE_MAX_DELAY_S=300
REWORK_RATE=0.002

# Spark
SPARK_DRIVER_MEMORY=3g
SPARK_UI_PORT=4045
SPARK_SHUFFLE_PARTITIONS=4
STREAM_TRIGGER_SECONDS=10
SILVER_DEDUP_WATERMARK=10 minutes

# SPC
SPC_WINDOW=1 minute
SPC_WATERMARK=1 minute
SPC_BASELINE_WINDOWS=5

# Dashboard
DASHBOARD_PORT=8501

# Airflow (local dev only, never reuse these anywhere real)
AIRFLOW_PORT=8081
AIRFLOW_UID=50000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
